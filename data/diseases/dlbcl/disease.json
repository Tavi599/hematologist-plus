{
  "id": "dlbcl",
  "name": {
    "uk": "Дифузна В-великоклітинна лімфома",
    "en": "Diffuse large B-cell lymphoma"
  },
  "summary": {
    "uk": "Агресивна В-клітинна неходжкінська лімфома; найчастіша лімфома в дорослих.",
    "en": "Aggressive B-cell non-Hodgkin lymphoma; the most common lymphoma in adults."
  },
  "codes": [
    {
      "system_id": "icd-10",
      "code": "C83.3",
      "is_primary": true
    }
  ],
